# Pooled connection used by the app (Neon: the "-pooler" host).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tradingquiz"
# Direct connection used by Prisma migrations (Neon: the host without "-pooler").
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tradingquiz"
# Public origin of the site, used for invite links and the same-origin check.
APP_URL="http://localhost:3000"
# Required to seed a non-local database. Local seeding falls back to a demo password.
SEED_PASSWORD=""
